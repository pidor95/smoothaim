; Engine configuration file.
config_version=5

[application]

config/name="Боевой Фронт"
config/description="PvP: танки, вертолёты, самолёты на реальной карте Прохоровки"
run/main_scene="res://main.tscn"
config/icon="res://icon.png"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.043, 0.059, 0.078, 1)

[display]

window/size/viewport_width=1600
window/size/viewport_height=720
window/handheld/orientation=4
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
environment/defaults/default_clear_color=Color(0.7, 0.77, 0.84, 1)
